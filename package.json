{
  "name": "cs3227-2610-mp3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude 'workflow/**'",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "test:admin:integration": "vitest run --config tests/integration/admin-accounts.vitest.config.mts",
    "test:admin-courses:integration": "vitest run --config tests/integration/admin-courses.vitest.config.mts",
    "test:e2e": "playwright test",
    "test:hooks": "node --test workflow/hooks/hooks.test.mjs",
    "test:workflow": "npm run test:hooks && vitest run workflow/hooks/hook-integration.test.mjs workflow/scripts/*.test.mjs",
    "check:spec": "node workflow/scripts/check-traceability.mjs",
    "check:secrets": "node workflow/scripts/check-secrets.mjs",
    "check:sensitive": "node workflow/scripts/review-sensitive-changes.mjs",
    "verify": "node workflow/scripts/verify.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "openai": "^7.36.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "secretlint": "^13.0.7",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
