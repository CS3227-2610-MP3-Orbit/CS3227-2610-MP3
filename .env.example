# Copy to .env.local for local development. Never commit real values.
# `npx supabase start` prints the local URL and keys.

# Supabase (safe for the browser; access is controlled by row-level security)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (server only; bypasses row-level security)
SUPABASE_SECRET_KEY=

# SoC LLMaaS (server only; OpenAI-compatible API)
SOCLAAS_BASE_URL=
SOCLAAS_API_KEY=
SOCLAAS_MODEL=
